# Copy to .env and fill in. Never commit the real token.

# Existing GitHub repo that holds your master resume (prefer private).
GITHUB_REPO=826-Leoyu/AutoApply
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_BRANCH=main

# Paths inside that repo
GITHUB_RESUME_PATH=resume/master.pdf
GITHUB_PROFILE_PATH=profile.json
GITHUB_OUT_PREFIX=applications

# Only tailor jobs at or above this score (0-100)
MATCH_MIN_SCORE=55
